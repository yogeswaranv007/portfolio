# Database Configuration (PostgreSQL / Neon)
DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Authentication (HS512 secret key, at least 64 characters)
JWT_SECRET=your_secure_random_64_char_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# Administrator Credentials (Used by DataSeeder to initialize/update admin login)
ADMIN_EMAIL=admin@yogeswaran.dev
ADMIN_PASSWORD=your_secure_admin_password_here

# Frontend URL (For CORS whitelist)
FRONTEND_URL=https://yogeswaran-v-portfolio-2005.vercel.app

# Brevo Email API (Optional, for contact form email routing)
BREVO_API_KEY=
FROM_EMAIL=
# Contact messages are notified to ADMIN_EMAIL

# GitHub API Token (Optional)
GITHUB_TOKEN=
