# ==============================================================================
# Portfolio Monorepo - Environment Variables Example
# ==============================================================================

# Backend Database (Neon PostgreSQL in Production, Local in Dev)
DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Authentication (HS512 secret, minimum 64 characters)
JWT_SECRET=generate_a_random_64_character_secret_key_here
JWT_EXPIRATION_MS=86400000

# Administrator Credentials (Used to configure the admin user account)
ADMIN_EMAIL=admin@yogeswaran.dev
ADMIN_PASSWORD=your_strong_admin_password_here

# Frontend CORS
FRONTEND_URL=https://yogeswaran-v-portfolio-2005.vercel.app

# Email Service (Brevo API)
BREVO_API_KEY=
FROM_EMAIL=
# Contact submissions will be forwarded to ADMIN_EMAIL

# GitHub API Token (Optional)
GITHUB_TOKEN=

# Frontend Environment Variables
VITE_API_BASE_URL=https://portfolio-yogeswaran-v-2005.onrender.com/api

